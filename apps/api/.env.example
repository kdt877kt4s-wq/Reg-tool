APP_NAME=RuleRadar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local dev values match docker-compose.yml at the repo root. The app
# connects as ruleradar_app: not a superuser, so row-level security applies.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ruleradar
DB_USERNAME=ruleradar_app
DB_PASSWORD=ruleradar_app

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=30

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@ruleradar.local
MAIL_FROM_NAME="${APP_NAME}"

# Azurite local blob emulator (Stage 4 evidence uploads).
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"

# AI keys are server-side only and loaded from Azure Key Vault in deployed
# environments. Never expose these to the web app.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

RULERADAR_DEMO_DATA=false
